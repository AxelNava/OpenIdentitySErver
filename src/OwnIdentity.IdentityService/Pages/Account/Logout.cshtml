@page
@model OwnIdentity.IdentityService.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<div class="auth-card">
    <p class="eyebrow">OwnIdentity</p>
    <h1>Sign out</h1>
    <p class="text-muted">End your identity service session on this browser.</p>
    <form method="post">
        <button type="submit" class="btn btn-dark w-100">Sign out</button>
    </form>
</div>
