@page
@model IndexModel
@{
    ViewData["Title"] = "Identity service";
}

<section class="hero">
    <p class="eyebrow">OwnIdentity</p>
    <h1>Identity service</h1>
    <p>ASP.NET Core Identity and OpenIddict provide authentication and delegated access for the administration client.</p>
    <div class="d-flex gap-2">
        @if (User.Identity?.IsAuthenticated is true)
        {
            <a class="btn btn-dark" asp-page="/Account/Logout">Sign out</a>
        }
        else
        {
            <a class="btn btn-dark" asp-page="/Account/Login">Sign in</a>
        }
        <a class="btn btn-outline-dark" href="http://localhost:5173">Open administration</a>
    </div>
</section>
